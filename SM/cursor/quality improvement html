function taSp(k){ return TA_SP[k]; }
function taNormalizeRow(r){
  var row={ ID:r.ID, Title:qiaStripHtml(r.Title) };
  Object.keys(TA_SP).forEach(function(k){
    var f=TA_SP[k], v=r[f];
    if (k === 'Owner') v = qiaPersonTitle(r.Owner) || v;
    if (TA_BOOL_KEYS.indexOf(k) >= 0) { row[f] = taFromSpBool(v); return; }
    if(['Repeated_Calls_Count','Repeated_TTs_Count','Reopened_TTs_Count','FCR_Impact_pct','Leakage_Cost_AED','Saving_Potential_AED'].indexOf(k)>=0)
      row[f]=Number(v||0);
    else if (TA_TEXT_KEYS.indexOf(k) >= 0) row[f] = qiaStripHtml(v);
    else row[f]=v==null?'':v;
  });
  return row;
}

