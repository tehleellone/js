window.qaLiveScore=function(){
  var type=(document.getElementById('qaAuditType')||{}).value||'';
  var criteria=qaGetCriteria(type), scores={};
  criteria.forEach(function(cat){
    var row=document.getElementById('qaRow_'+cat.id), sc=document.getElementById('qaScore_'+cat.id);
    if(row&&row.dataset.naOn==='true'){ scores[cat.id]=null; return; }
    var v=sc?sc.value:''; scores[cat.id]=(v===''||v===undefined)?null:parseFloat(v);
  });
  var filled=criteria.filter(function(c){ var s=scores[c.id]; return s!==null&&s!==undefined&&!isNaN(s); });
  var pct=qaCalcScore(scores,type);
  var outcome=qaOutcomeFromScore(pct);
  qaSelectedOutcome=outcome;
  var bd=document.getElementById('qaScoreBreakdown'), td=document.getElementById('qaTotalScoreDisplay'), op=document.getElementById('qaOutcomePill');
  if(!filled.length){
    if(bd) bd.textContent='No scores entered yet';
    if(td) td.textContent='— / 100';
    if(op){ op.textContent='—'; op.style.background='var(--chip)'; op.style.color='var(--t3)'; }
    return;
  }
  if(bd) bd.textContent='Based on '+filled.length+' of '+criteria.length+' criteria scored';
  if(td){ td.textContent=pct+' / 100'; td.style.color=pct>=70?'#10b981':pct>=50?'#f59e0b':'#ef4444'; }
  if(op){
    op.textContent=outcome;
    if(outcome==='Pass'){ op.style.background='rgba(16,185,129,.15)'; op.style.color='#10b981'; }
    else if(outcome==='Fail'){ op.style.background='rgba(239,68,68,.12)'; op.style.color='#ef4444'; }
    else { op.style.background='rgba(245,158,11,.12)'; op.style.color='#f59e0b'; }
  }
};

