function qiaInitSpUrl() {
  try {
    if (window._spPageContextInfo && window._spPageContextInfo.webAbsoluteUrl) {
      SP_URL = String(window._spPageContextInfo.webAbsoluteUrl).replace(/\/$/, '');
      return;
    }
    var m = window.location.pathname.match(/(\/sites\/[^/]+)/i);
