function taBuildSubmitPayload() {
  var body = {};
  Object.keys(TA_SP).forEach(function(k) {
    var el = document.getElementById(taFieldId(k));
    if (!el) return;
    var v = el.value;
    if (v === '' || v === null || v === undefined) return;
    if (TA_BOOL_KEYS.indexOf(k) >= 0) {
      var b = taToSpBool(v);
      if (b !== undefined) body[TA_SP[k]] = b;
      return;
    }
    if (TA_NUM_KEYS.indexOf(k) >= 0) body[TA_SP[k]] = Number(v);
    else body[TA_SP[k]] = v;
  });
  if (!body[TA_SP.Customer_Claim]) throw new Error('Customer Claim is required');
  if (!body[TA_SP.Date_Time]) throw new Error('Date & Time is required');
  body.Title = String(body[TA_SP.Customer_Claim]).substring(0, 255);
  body[TA_SP.Date_Time] = qiaToSpDate(body[TA_SP.Date_Time]);
  if (body[TA_SP.Target_Date]) body[TA_SP.Target_Date] = qiaToSpDate(body[TA_SP.Target_Date]);
  delete body[TA_SP.Owner];
  return body;
}

window.taSaveAnalysis=async function(){
  var root=document.getElementById('taFormRoot');
  var msgEl=document.getElementById('taSubmitMsg');
  if(!root){
    if(msgEl) msgEl.innerHTML='<span style="color:#ef4444;">Submit form not loaded — click Submit Analysis tab again.</span>';
    return;
  }
  var dt=document.getElementById(taFieldId('Date_Time'));
  var cc=document.getElementById(taFieldId('Customer_Claim'));
  if(!dt||!dt.value){ if(msgEl) msgEl.innerHTML='<span style="color:#ef4444;">Date & Time is required.</span>'; if(dt) dt.focus(); return; }
  if(!cc||!cc.value.trim()){ if(msgEl) msgEl.innerHTML='<span style="color:#ef4444;">Customer Claim is required.</span>'; if(cc) cc.focus(); return; }
  if(msgEl) msgEl.innerHTML='<span style="color:var(--t3);">Preparing save…</span>';
  try{
    var body=taBuildSubmitPayload();
    if(QIA_DUMMY_MODE){
      qiaTopics.unshift(Object.assign({ID:qiaTopics.length+1},body));
      if(msgEl) msgEl.innerHTML='<span style="color:#10b981;">Saved locally (demo mode)</span>';
      taSetTab('analytics'); taRenderAnalytics();
      return;
    }
    if(msgEl) msgEl.innerHTML='<span style="color:var(--t3);">Saving to SharePoint…</span>';
    var created=await qiaSpCreateItem(LIST_TOPIC, body);
    await qiaFetchTopics();
    taSetTab('analytics');
    taRenderAnalytics();
