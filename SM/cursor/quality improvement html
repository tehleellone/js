window.qaSubmitAudit=async function(){
  var type=(document.getElementById('qaAuditType')||{}).value;
  var team=(document.getElementById('qaTeam')||{}).value;
  var agent=((document.getElementById('qaAgentName')||{}).value||'').trim();
  var errors=[];
  if(!type) errors.push('Audit Type is required');
  if(!team) errors.push('Team is required');
  if(!agent) errors.push('Agent Name is required');
  var criteria=qaGetCriteria(type||'Call'), unscored=[], hasScored=false;
  criteria.forEach(function(cat){
    var row=document.getElementById('qaRow_'+cat.id), sc=document.getElementById('qaScore_'+cat.id);
    if(!row||row.dataset.naOn==='true') return;
    hasScored=true;
    if(!sc||sc.value===''){ unscored.push(cat.label); if(sc) sc.classList.add('qa-required-err'); if(row) row.classList.add('qa-row-err'); }
  });
  if(!hasScored) errors.push('Score at least one criterion (turn off N/A on rows you want to score)');
  if(unscored.length) errors.push('Complete scores for active criteria: '+unscored.slice(0,3).join(', '));
  if(errors.length){ qaShowError(errors.map(function(e,i){ return (i+1)+'. '+e; }).join('<br>')); return; }

  var scoreData={}, naFields=[];
  qaAllCriteriaCols().forEach(function(cat){
    var inScope=criteria.find(function(c){ return c.id===cat.id; });
    if(!inScope){ scoreData[cat.id]=null; return; }
    var row=document.getElementById('qaRow_'+cat.id), sc=document.getElementById('qaScore_'+cat.id);
    if(row&&row.dataset.naOn==='true'){ scoreData[cat.id]=null; naFields.push(cat.id); return; }
    scoreData[cat.id]=sc?parseFloat(sc.value):null;
  });
  var totalScore=qaCalcScore(scoreData,type);
  var outcome=qaOutcomeFromScore(totalScore);
  qaSelectedOutcome=outcome;
  var ref=((document.getElementById('qaReferenceID')||{}).value||'').trim();
  var dateEval=(document.getElementById('qaDateOfEval')||{}).value;
  var dateField=(document.getElementById('qaDateField')||{}).value;

  if(QIA_DUMMY_MODE){
    var row={ID:qiaQaAudits.length+1,Title:ref||('QIA-QA-'+Date.now()),Reference_ID:ref,Audit_Type:type,Team:team,Agent_Name:agent,Evaluator:window.USER_CONTEXT.userName,Date_of_Eval:dateEval,Comments:qaGetMergedComments(),Avg_Score:totalScore,Outcome:outcome};
    qaAllCriteriaCols().forEach(function(c){ if(scoreData[c.id]!=null) row[c.id]=scoreData[c.id]; });
    if(type==='Call'){ row.Date_of_Call=dateField; row.MSISDN=(document.getElementById('qaMSISDN')||{}).value||''; row.Call_Reason=(document.getElementById('qaCallReason')||{}).value||''; row.Call_Duration=(parseInt((document.getElementById('qaDurMin')||{}).value||0,10)*60+parseInt((document.getElementById('qaDurSec')||{}).value||0,10)); }
    else { row.Date_of_Email=dateField; row.Email_Reason=(document.getElementById('qaEmailReason')||{}).value||''; row.Email_Subject=(document.getElementById('qaEmailSubject')||{}).value||''; }
    qiaQaAudits.unshift(row); document.getElementById('qaSubmitMsg').innerHTML='<span style="color:#10b981;">Audit saved (demo mode)</span>'; qaClearForm(); return;
  }
  qaSubmitToSp({type:type,team:team,agent:agent,ref:ref,dateEval:dateEval,dateField:dateField,scoreData:scoreData,naFields:naFields,totalScore:totalScore,outcome:outcome,comments:qaGetMergedComments()});
};

async function qaSubmitToSp(data){
  var msgEl=document.getElementById('qaSubmitMsg');
  if(msgEl) msgEl.innerHTML='<span style="color:var(--t3);">Submitting…</span>';
  try{
    var evaluatorId=await qiaGetCurrentUserId();
    var body={
      Title: data.ref || (data.type+'-'+new Date().toISOString().split('T')[0]),
      Reference_ID: data.ref || '',
      Audit_Type: data.type,
      Team: data.team,
      Agent_Name: data.agent,
      EvaluatorId: evaluatorId,
      Date_of_Eval: qiaToSpDate(data.dateEval),
      Avg_Score: data.totalScore,
      Outcome: data.outcome
    };
    if(data.comments) body.Comments=data.comments;
    if(data.naFields.length) body.NA_Fields=data.naFields.map(function(f){ return f.split('_')[0]; }).join('|').substring(0,255);
    if(data.type==='Call'){
      if(data.dateField) body.Date_of_Call=qiaToSpDate(data.dateField);
      var min=parseInt((document.getElementById('qaDurMin')||{}).value||0,10);
      var sec=parseInt((document.getElementById('qaDurSec')||{}).value||0,10);
      var dur=min*60+sec;
      if(dur) body.Call_Duration=dur;
      if(dur) body.Call_Duration_Type=dur<=120?'Short':dur<=300?'Standard':'Long';
      var msisdn=((document.getElementById('qaMSISDN')||{}).value||'').trim();
      var callReason=((document.getElementById('qaCallReason')||{}).value||'').trim();
      if(msisdn) body.MSISDN=msisdn;
      if(callReason) body.Call_Reason=callReason;
    } else {
      if(data.dateField) body.Date_of_Email=qiaToSpDate(data.dateField);
      var er=((document.getElementById('qaEmailReason')||{}).value||'').trim();
      var es=((document.getElementById('qaEmailSubject')||{}).value||'').trim();
      if(er) body.Email_Reason=er;
      if(es) body.Email_Subject=es;
    }
    qaAllCriteriaCols().forEach(function(cat){
      var v=data.scoreData[cat.id];
      if(v!==null&&v!==undefined&&!isNaN(v)) body[cat.id]=v;
    });
    await qiaSpCreateItem(LIST_QA, body);
    await qiaFetchQaAudits();
    if(msgEl) msgEl.innerHTML='<span style="color:#10b981;">Submitted to SharePoint</span>';
    qaClearForm();
  }catch(e){
    if(msgEl) msgEl.innerHTML='<span style="color:#ef4444;">'+qiaEsc(e.message||String(e))+'</span>';
  }
}

function qaRenderAnalyticsSection(){
  document.getElementById('qaTabAnalyticsSection').innerHTML=
    '<div class="filters-section"><div class="filters-grid">'+
    '<div class="filter-group"><label class="filter-label">Team</label><select class="filter-select" id="qaFilterTeam" onchange="qaRenderAnalytics()"><option value="">All</option>'+qiaTeamOptions()+'</select></div>'+
    '<div class="filter-group"><label class="filter-label">Agent</label><select class="filter-select" id="qaFilterAgent" onchange="qaRenderAnalytics()"><option value="">All</option></select></div>'+
    '<div class="filter-group"><label class="filter-label">Evaluator</label><select class="filter-select" id="qaFilterEvaluator" onchange="qaRenderAnalytics()"><option value="">All</option></select></div>'+
    '<div class="filter-group"><label class="filter-label">From</label><input type="date" class="filter-select" id="qaFilterFrom" onchange="qaRenderAnalytics()"></div>'+
    '<div class="filter-group"><label class="filter-label">To</label><input type="date" class="filter-select" id="qaFilterTo" onchange="qaRenderAnalytics()"></div>'+
    '<div class="filter-group"><label class="filter-label">Search</label><input class="filter-select" id="qaAnalyticsSearch" placeholder="Agent or evaluator..." oninput="qaRenderAnalytics()"></div>'+
    '</div><div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px;"><button class="reset-btn" type="button" onclick="qaResetFilters()">Reset</button></div></div>'+
    '<div style="display:flex;gap:8px;margin-bottom:1rem;"><button type="button" class="qa-atab-btn active" onclick="qaSetAnalyticsTab(\'Call\')">Call</button><button type="button" class="qa-atab-btn" onclick="qaSetAnalyticsTab(\'Email\')">Email</button></div>'+
    '<div id="qaKPITiles"></div><div id="qaSelectionTiles" style="margin-bottom:1rem;"></div>'+
    '<div style="text-align:center;margin-bottom:1rem;"><button class="export-btn" type="button" onclick="qaToggleCharts()"><span id="qaChartsBtnText">Show Analytics Charts</span></button></div>'+
    '<div id="qaChartsSection" style="display:none;"></div><div id="qaGridWrap"></div>';
  qaRenderAnalytics();
}

window.qaSetAnalyticsTab=function(tab){
  qaAnalyticsTab=tab;
  document.querySelectorAll('.qa-atab-btn').forEach(function(b){ b.classList.toggle('active', b.textContent.trim()===tab); });
  if(qaChartsVisible){ document.getElementById('qaChartsSection').innerHTML=qaChartsHTML(); qaRenderCharts(qaGetFiltered()); }
  qaRenderAnalytics();
};

window.qaGetFiltered=function(){
  var data=qiaQaAudits.filter(function(a){ return a.Audit_Type===qaAnalyticsTab; });
  var team=(document.getElementById('qaFilterTeam')||{}).value||'';
  var agent=(document.getElementById('qaFilterAgent')||{}).value||'';
  var evaluator=(document.getElementById('qaFilterEvaluator')||{}).value||'';
  var from=(document.getElementById('qaFilterFrom')||{}).value||'';
  var to=(document.getElementById('qaFilterTo')||{}).value||'';
  var search=((document.getElementById('qaAnalyticsSearch')||{}).value||'').toLowerCase().trim();
  return data.filter(function(a){
    if(team&&a.Team!==team) return false;
    if(agent&&a.Agent_Name!==agent) return false;
    if(evaluator&&a.Evaluator!==evaluator) return false;
    if(search&&!(a.Agent_Name||'').toLowerCase().includes(search)&&!(a.Evaluator||'').toLowerCase().includes(search)) return false;
    var d=a.Date_of_Call||a.Date_of_Email||a.Date_of_Eval;
    if(from&&d&&new Date(d)<new Date(from)) return false;
    if(to&&d&&new Date(d)>new Date(to+'T23:59:59')) return false;
    return true;
  });
};

window.qaResetFilters=function(){
  ['qaFilterTeam','qaFilterAgent','qaFilterEvaluator'].forEach(function(id){ var el=document.getElementById(id); if(el) el.selectedIndex=0; });
  ['qaFilterFrom','qaFilterTo','qaAnalyticsSearch'].forEach(function(id){ var el=document.getElementById(id); if(el) el.value=''; });
  qaRenderAnalytics();
};

window.qaRenderAnalytics=function(){
  var data=qaGetFiltered();
  qaPopulateFilterDropdowns(data);
  var total=data.length, avg=total?(data.reduce(function(s,a){return s+(a.Avg_Score||0);},0)/total).toFixed(1):0;
  var passed=data.filter(function(a){return a.Outcome==='Pass';}).length;
  var failed=data.filter(function(a){return a.Outcome==='Fail';}).length;
  var passRate=total?Math.round((passed/total)*100):0;
  var kpis=[
    {label:'Total Audits',val:total,color:'#0d9488'},{label:'Avg Score',val:avg+'%',color:'#f59e0b'},
    {label:'Pass Rate',val:passRate+'%',color:'#10b981'},{label:'Fails',val:failed,color:'#ef4444'},
    {label:'Passed',val:passed,color:'#10b981'},{label:qaAnalyticsTab+' Audits',val:total,color:'#8b5cf6'}
  ];
  document.getElementById('qaKPITiles').innerHTML='<div class="top-stats">'+kpis.map(function(k){
    return '<div class="stat-card"><div class="stat-label">'+k.label+'</div><div class="stat-value" style="color:'+k.color+'">'+k.val+'</div></div>';
  }).join('')+'</div>';
  qaRenderAgentTiles(data);
  qaRenderQaGrid(data);
  if(qaChartsVisible) qaRenderCharts(data);
};

function qaPopulateFilterDropdowns(data){
  function fill(id, vals, label){
    var sel=document.getElementById(id); if(!sel||sel.options.length>1) return;
    [...new Set(vals)].filter(Boolean).sort().forEach(function(v){ var o=document.createElement('option'); o.value=v; o.textContent=v; sel.appendChild(o); });
  }
  fill('qaFilterAgent', qiaQaAudits.filter(function(a){return a.Audit_Type===qaAnalyticsTab;}).map(function(a){return a.Agent_Name;}));
  fill('qaFilterEvaluator', qiaQaAudits.map(function(a){return a.Evaluator;}));
}

function qaRenderAgentTiles(data){
  var agents=[...new Set(data.map(function(a){return a.Agent_Name;}))].filter(Boolean).sort();
  var el=document.getElementById('qaSelectionTiles');
  if(!agents.length){ el.innerHTML=''; return; }
  el.innerHTML='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.85rem;">'+agents.slice(0,8).map(function(ag){
    var agData=data.filter(function(a){return a.Agent_Name===ag;});
    var avg=agData.length?(agData.reduce(function(s,a){return s+(a.Avg_Score||0);},0)/agData.length).toFixed(0):0;
    var color=avg>=70?'#10b981':avg>=50?'#f59e0b':'#ef4444';
    return '<div class="lm-tile" onclick="document.getElementById(\'qaFilterAgent\').value=\''+ag.replace(/'/g,"\\'")+'\';qaRenderAnalytics();"><h3>'+qiaEsc(ag)+'</h3><div class="lm-stat-value" style="color:'+color+'">'+avg+'%</div><div style="font-size:.72rem;color:var(--t3);">'+agData.length+' audits</div></div>';
  }).join('')+'</div>';
}

function qaRenderQaGrid(data){
  var wrap=document.getElementById('qaGridWrap');
  if(qaGridApi){ try{qaGridApi.destroy();}catch(e){} qaGridApi=null; }
  wrap.innerHTML='<div class="table-section"><div class="table-header"><div class="table-title">'+qaAnalyticsTab+' Audits</div><div><button class="export-btn" type="button" onclick="qaExportCSV()">Export</button></div></div><div id="qaGridDiv" class="ag-theme-alpine" style="height:480px;width:100%;"></div></div>';
  var cols=[
    qiaSetFilterCol({field:'Team',headerName:'Team',width:90}, qiaTeams.slice()),
    {field:'Agent_Name',headerName:'Agent',width:150,filter:QiaSetColumnFilter},
    {field:'Evaluator',headerName:'Evaluator',width:130,filter:QiaSetColumnFilter},
    {field:'Reference_ID',headerName:'Ref ID',width:120,filter:QiaSetColumnFilter},
    {field:'Date_of_Eval',headerName:'Eval Date',width:110,filter:QiaSetColumnFilter,valueFormatter:function(p){return qiaFmtDate(p.value);}},
    {field:'Date_of_Call',headerName:'Audit Date',width:110,filter:QiaSetColumnFilter,valueFormatter:function(p){var v=p.data.Date_of_Call||p.data.Date_of_Email||'';return qiaFmtDate(v);}},
    {field:'Avg_Score',headerName:'Score',width:90,filter:QiaSetColumnFilter,cellRenderer:function(p){var s=p.value||0,color=s>=70?'#10b981':s>=50?'#f59e0b':'#ef4444';return '<span style="font-weight:800;color:'+color+'">'+s+'%</span>';}},
    qiaSetFilterCol({field:'Outcome',headerName:'Outcome',width:140,cellRenderer:function(p){var c=p.value==='Pass'?'#10b981':p.value==='Fail'?'#ef4444':'#f59e0b';return '<span class="status-badge" style="background:'+c+'22;color:'+c+'">'+qiaEsc(p.value)+'</span>';}},['Pass','Needs Improvement','Fail'])
  ];
  agGrid.createGrid(document.getElementById('qaGridDiv'),{columnDefs:cols,rowData:data,defaultColDef:qiaGridDefaults(),pagination:true,paginationPageSize:20,onGridReady:function(p){qaGridApi=p.api;}});
}

window.qaExportCSV=function(){ if(qaGridApi) qaGridApi.exportDataAsCsv({fileName:'QIA_QA_'+qaAnalyticsTab+'_'+new Date().toISOString().split('T')[0]+'.csv'}); };

window.qaToggleCharts=function(){
  qaChartsVisible=!qaChartsVisible;
  var sec=document.getElementById('qaChartsSection');
  sec.style.display=qaChartsVisible?'block':'none';
  document.getElementById('qaChartsBtnText').textContent=qaChartsVisible?'Hide Analytics Charts':'Show Analytics Charts';
  if(qaChartsVisible){ sec.innerHTML=qaChartsHTML(); qaRenderCharts(qaGetFiltered()); }
};

function qaChartsHTML(){
  return '<div class="chart-card"><div class="chart-title">Score Trend</div><canvas id="qaScoreTrendChart" height="220"></canvas></div>'+
    '<div class="charts-grid"><div class="chart-card"><div class="chart-title">Agent Performance</div><canvas id="qaAgentScoreChart" height="240"></canvas></div>'+
    '<div class="chart-card"><div class="chart-title">Outcome Distribution</div><canvas id="qaOutcomeChart" height="240"></canvas></div></div>'+
    '<div class="charts-grid"><div class="chart-card"><div class="chart-title">Pass / Fail Trend</div><canvas id="qaMonthlyTrendChart" height="220"></canvas></div>'+
    '<div class="chart-card"><div class="chart-title">Evaluator Productivity</div><canvas id="qaEvaluatorChart" height="220"></canvas></div></div>'+
    '<div class="chart-card"><div class="chart-title">Criteria Heatmap</div><div id="qaHeatmap"></div></div>'+
    '<div class="chart-card"><div class="chart-title">Bottom 5 Agents</div><div id="qaBottom5"></div></div>';
}

function qaDestroyChart(id){ var c=document.getElementById(id); if(c&&c._chart){c._chart.destroy();c._chart=null;} }

function qaRenderCharts(data){
  qaDestroyChart('qaScoreTrendChart'); qaDestroyChart('qaAgentScoreChart'); qaDestroyChart('qaOutcomeChart');
  qaDestroyChart('qaMonthlyTrendChart'); qaDestroyChart('qaEvaluatorChart');
  function getDate(a){ return a.Date_of_Call||a.Date_of_Email||a.Date_of_Eval||''; }
  var monthMap={};
  data.forEach(function(a){ var d=getDate(a); if(!d)return; var k=new Date(d).toISOString().slice(0,7); if(!monthMap[k]) monthMap[k]={pass:0,needs:0,fail:0}; if(a.Outcome==='Pass')monthMap[k].pass++; else if(a.Outcome==='Needs Improvement')monthMap[k].needs++; else monthMap[k].fail++; });
  var mk=Object.keys(monthMap).sort();
  var st=document.getElementById('qaScoreTrendChart');
  if(st) st._chart=new Chart(st,{type:'line',data:{labels:mk,datasets:[
    {label:'Pass',data:mk.map(function(k){return monthMap[k].pass;}),borderColor:'#10b981',tension:.35},
    {label:'Needs',data:mk.map(function(k){return monthMap[k].needs;}),borderColor:'#f59e0b',tension:.35},
    {label:'Fail',data:mk.map(function(k){return monthMap[k].fail;}),borderColor:'#ef4444',tension:.35}
  ]},options:{responsive:true,plugins:{legend:{position:'top'}},scales:{y:{beginAtZero:true}}}});
  var agents=[...new Set(data.map(function(a){return a.Agent_Name;}))].filter(Boolean).sort();
  var agentAvgs=agents.map(function(ag){ var d=data.filter(function(a){return a.Agent_Name===ag;}); return d.length?+(d.reduce(function(s,a){return s+(a.Avg_Score||0);},0)/d.length).toFixed(1):0; });
  var a1=document.getElementById('qaAgentScoreChart');
  if(a1) a1._chart=new Chart(a1,{type:'bar',data:{labels:agents,datasets:[{label:'Avg %',data:agentAvgs,backgroundColor:'#0d9488',borderRadius:6}]},options:{indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{max:100,beginAtZero:true}}}});
  var passC=data.filter(function(a){return a.Outcome==='Pass';}).length, needsC=data.filter(function(a){return a.Outcome==='Needs Improvement';}).length, failC=data.filter(function(a){return a.Outcome==='Fail';}).length;
  var o1=document.getElementById('qaOutcomeChart');
  if(o1) o1._chart=new Chart(o1,{type:'doughnut',data:{labels:['Pass','Needs Improvement','Fail'],datasets:[{data:[passC,needsC,failC],backgroundColor:['#10b981','#f59e0b','#ef4444']}]},options:{plugins:{legend:{position:'bottom'}}}});
  var m1=document.getElementById('qaMonthlyTrendChart');
  if(m1) m1._chart=new Chart(m1,{type:'bar',data:{labels:mk,datasets:[
    {label:'Pass',data:mk.map(function(k){return monthMap[k].pass;}),backgroundColor:'#10b981'},
    {label:'Needs',data:mk.map(function(k){return monthMap[k].needs;}),backgroundColor:'#f59e0b'},
    {label:'Fail',data:mk.map(function(k){return monthMap[k].fail;}),backgroundColor:'#ef4444'}
  ]},options:{scales:{x:{stacked:true},y:{stacked:true,beginAtZero:true}}}});
  var evaluators=[...new Set(data.map(function(a){return a.Evaluator;}))].filter(Boolean).sort();
  var e1=document.getElementById('qaEvaluatorChart');
  if(e1) e1._chart=new Chart(e1,{type:'bar',data:{labels:evaluators,datasets:[{label:'Audits',data:evaluators.map(function(ev){return data.filter(function(a){return a.Evaluator===ev;}).length;}),backgroundColor:'#14b8a6',borderRadius:6}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});
  qaRenderHeatmap(data);
  qaRenderBottom5(data);
}

function qaRenderHeatmap(data){
  var el=document.getElementById('qaHeatmap'); if(!el) return;
  var criteria=qaGetCriteria(qaAnalyticsTab);
  var rows=criteria.map(function(cat){
    var rel=data.filter(function(a){return a[cat.id]!==null&&a[cat.id]!==undefined&&a[cat.id]!=='';});
    if(!rel.length) return null;
    var avg=rel.reduce(function(s,a){return s+(a[cat.id]||0);},0)/rel.length;
    return {cat:cat,avg:avg,count:rel.length};
  }).filter(Boolean).sort(function(a,b){return a.avg-b.avg;});
  el.innerHTML=rows.map(function(r){
    var pct=(r.avg/QA_MAX_PER_CRITERION*100).toFixed(0), color=r.avg>=1.4?'#10b981':r.avg>=0.8?'#f59e0b':'#ef4444';
    return '<div style="display:flex;align-items:center;gap:12px;padding:8px 0;"><div style="width:200px;font-size:.82rem;font-weight:600;">'+r.cat.label+'</div><div style="flex:1;background:var(--bg-secondary);border-radius:20px;height:8px;"><div style="height:100%;width:'+pct+'%;background:'+color+';border-radius:20px;"></div></div><div style="width:60px;text-align:right;font-weight:700;color:'+color+'">'+r.avg.toFixed(2)+'/2</div></div>';
  }).join('')||'<div style="color:var(--t3);padding:20px;text-align:center;">No data</div>';
}

function qaRenderBottom5(data){
  var el=document.getElementById('qaBottom5'); if(!el) return;
  var agents=[...new Set(data.map(function(a){return a.Agent_Name;}))].filter(Boolean);
  var stats=agents.map(function(ag){
    var d=data.filter(function(a){return a.Agent_Name===ag;});
    return {name:ag,avg:d.length?d.reduce(function(s,a){return s+(a.Avg_Score||0);},0)/d.length:0,count:d.length};
  }).sort(function(a,b){return a.avg-b.avg;}).slice(0,5);
  el.innerHTML=stats.map(function(s,i){
    var color=s.avg>=70?'#10b981':s.avg>=50?'#f59e0b':'#ef4444';
    return '<div style="display:flex;align-items:center;gap:12px;padding:10px;border-bottom:1px solid var(--border);"><div style="font-weight:900;color:#ef4444;">#'+(i+1)+'</div><div style="flex:1;font-weight:700;">'+qiaEsc(s.name)+'</div><div style="font-size:.78rem;color:var(--t3);">'+s.count+' audits</div><div style="font-weight:900;color:'+color+'">'+s.avg.toFixed(1)+'%</div></div>';
  }).join('')||'<div style="color:var(--t3);padding:20px;text-align:center;">No data</div>';
}

</script>
