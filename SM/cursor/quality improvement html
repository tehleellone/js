function qiaPersonTitle(v) {
  if (!v) return '';
  if (typeof v === 'string') return v;
  if (v.Title) return v.Title;
  if (v.results && v.results[0]) return v.results[0].Title || '';
  return '';
}

function qiaFirstKey(obj, keys) {
  for (var i = 0; i < keys.length; i++) {
    if (obj[keys[i]] !== undefined && obj[keys[i]] !== null && obj[keys[i]] !== '') return obj[keys[i]];
  }
  return '';
}

async function qiaLoadTeamChoices() {
  if (QIA_DUMMY_MODE) { qiaTeams = ['A','B','C']; return; }
  qiaTeams = [];
  try {
    var url = qiaListApi(LIST_QA, "/fields/getbyinternalnameortitle('Team')");
    var res = await qiaFetchSp(url);
    if (res.ok) {
      var data = await res.json();
      var choices = data.d && data.d.Choices && data.d.Choices.results;
      if (choices && choices.length) qiaTeams = choices.slice();
    }
  } catch(e) { console.warn('[QIA] Team choices fetch failed', e); }
  qiaQaAudits.forEach(function(a) {
    if (a.Team && qiaTeams.indexOf(a.Team) < 0) qiaTeams.push(a.Team);
  });
  qiaTeams.sort();
}

