}

function qiaEsc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function qiaStripHtml(html) {
  if (html == null || html === '') return '';
  var s = String(html);
  if (s.indexOf('<') < 0) return s.trim();
  s = s.replace(/<br\s*\/?>/gi, '\n').replace(/<\/p>/gi, '\n').replace(/<\/div>/gi, '\n');
  var el = document.createElement('div');
  el.innerHTML = s;
  var text = el.textContent || el.innerText || '';
  return text.replace(/\u00a0/g, ' ').replace(/\n{3,}/g, '\n\n').trim();
}

window.onerror = function(msg, src, line) {
  var el = document.getElementById('taLoading');
  if (el && el.style.display !== 'none') {
    el.innerHTML = '<div style="text-align:center;padding:40px;max-width:560px;margin:0 auto;">' +
