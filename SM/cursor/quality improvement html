    row.dataset.naOn='false'; row.classList.remove('qa-na-active');
    sc.style.display='block'; sc.disabled=false;
    if(badge) badge.style.display='none';
    btn.classList.remove('na-on'); btn.classList.add('na-off');
  } else {
    row.dataset.naOn='true'; row.classList.add('qa-na-active');
    sc.style.display='none'; sc.disabled=true; sc.value=''; sc.classList.remove('qa-required-err');
    if(badge) badge.style.display='inline';
