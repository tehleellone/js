// AG Grid multi-select set filter (same pattern as SM)
function QiaSetColumnFilter(){}
QiaSetColumnFilter.prototype.init=function(params){
  this.params=params; this.selected=new Set(); this.fixedValues=params.colDef.filterParams&&params.colDef.filterParams.values;
  this.gui=document.createElement('div'); this.gui.className='qia-ag-set-filter'; this._buildGui();
};
QiaSetColumnFilter.prototype._cellValue=function(data){
  var field=this.params.colDef.field, v=data[field];
  if(this.params.colDef.valueGetter) v=this.params.colDef.valueGetter({data:data});
  if(v===null||v===undefined||v==='') return '—';
  if(this.params.colDef.valueFormatter){ var f=this.params.colDef.valueFormatter({value:v,data:data}); return String(f==null?'—':f); }
  return String(v);
};
QiaSetColumnFilter.prototype._allValues=function(){
  if(this.fixedValues) return this.fixedValues.slice();
  var values=new Set(), self=this;
  this.params.api.forEachNode(function(node){ if(node.data) values.add(self._cellValue(node.data)); });
  return Array.from(values).sort(function(a,b){ return a.localeCompare(b); });
};
QiaSetColumnFilter.prototype._buildGui=function(){
  var self=this, all=this._allValues(); this.gui.innerHTML='';
  var search=document.createElement('input'); search.type='text'; search.placeholder='Search...'; search.className='qia-ag-set-search'; this.gui.appendChild(search);
  var list=document.createElement('div'); list.className='qia-ag-set-list'; this.gui.appendChild(list);
  var render=function(term){
    list.innerHTML='';
    all.filter(function(v){ return !term||v.toLowerCase().indexOf(term.toLowerCase())>=0; }).forEach(function(v){
      var row=document.createElement('label'); row.className='qia-ag-set-option';
      var cb=document.createElement('input'); cb.type='checkbox'; cb.checked=self.selected.has(v);
      cb.onchange=function(){ if(cb.checked) self.selected.add(v); else self.selected.delete(v); self.params.filterChangedCallback(); };
      row.appendChild(cb); row.appendChild(document.createTextNode(' '+v)); list.appendChild(row);
    });
  };
  render(''); search.oninput=function(){ render(search.value); };
  var actions=document.createElement('div'); actions.className='qia-ag-set-actions';
