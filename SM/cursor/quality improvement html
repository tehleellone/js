// QUALITY ASSURANCE (QIA — Call & Email only)
function qaGetCriteria(type){ return type==='Email'?QA_EMAIL_CRITERIA:QA_CALL_CRITERIA; }
function qaCalcScore(scores,type){
  var criteria=qaGetCriteria(type), sum=0, count=0;
  criteria.forEach(function(c){ var v=scores[c.id]; if(v===null||v===undefined||v==='')return; var n=parseFloat(v); if(isNaN(n))return; sum+=Math.min(QA_MAX_PER_CRITERION,Math.max(0,n)); count++; });
  return count?Math.round((sum/(count*QA_MAX_PER_CRITERION))*100):0;
}
function qaOutcomeFromScore(s){ return s>=70?'Pass':s>=50?'Needs Improvement':'Fail'; }

