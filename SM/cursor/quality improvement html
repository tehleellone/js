function qiaParseSpError(text) {
  try {
    var j = JSON.parse(text);
    if (j.error && j.error.message && j.error.message.value) return j.error.message.value;
  } catch(e) {}
  return String(text || 'Unknown error').substring(0, 600);
}

async function qiaSpCreateItem(listTitle, fields) {
  var digest = await qiaGetDigest();
  var itemType = await qiaGetListItemType(listTitle);
  var body = { __metadata: { type: itemType } };
  Object.keys(fields).forEach(function(k) {
    var v = fields[k];
    if (v === undefined || v === null || v === '') return;
    body[k] = v;
  });
  console.log('[QIA] POST', listTitle, body);
  var res = await fetch(qiaListApi(listTitle, '/items'), {
    method: 'POST',
    headers: { 'Accept': 'application/json;odata=verbose', 'Content-Type': 'application/json;odata=verbose', 'X-RequestDigest': digest },
    credentials: 'include',
    body: JSON.stringify(body)
  });
  if (!res.ok) throw new Error(qiaParseSpError(await res.text()));
  return (await res.json()).d;
}
