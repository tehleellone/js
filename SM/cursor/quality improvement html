<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QIA — Quality Improvement & Assurance</title>
<link rel="stylesheet" href="https://unpkg.com/ag-grid-community@32.0.2/styles/ag-grid.css">
<link rel="stylesheet" href="https://unpkg.com/ag-grid-community@32.0.2/styles/ag-theme-alpine.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
<style>
/* QIA TEAL LIGHT */
:root{
  --bg-body:linear-gradient(145deg,#f0fdf9,#ecfdf5,#f0fdfa);
  --bg-card:#fff;--bg-header:rgba(255,255,255,.97);--bg-sidebar:linear-gradient(180deg,#f0fdf9,#ecfdf5);
  --bg-content:#f0fdfa;--bg-input:rgba(13,148,136,.06);--bg-secondary:rgba(13,148,136,.05);--bg-hover:rgba(13,148,136,.08);
  --border:rgba(13,148,136,.2);--border-s:rgba(13,148,136,.45);
  --t1:#0f2f2a;--t2:#2d6b60;--t3:#5f9e92;--acc:#0d9488;--acc2:#14b8a6;
  --glow:rgba(13,148,136,.28);--grad:linear-gradient(135deg,#0d9488,#14b8a6);
  --nab:rgba(13,148,136,.1);--nab2:rgba(13,148,136,.35);--sc:#0d9488;
  --cs:0 1px 8px rgba(13,148,136,.12);--ch:0 6px 20px rgba(13,148,136,.2);--chip:rgba(13,148,136,.08);
}
body[data-theme="dark"]{
  --bg-body:linear-gradient(145deg,#041512,#062420,#041916);
  --bg-card:#0a2420;--bg-header:rgba(4,21,18,.98);--bg-sidebar:linear-gradient(180deg,#0a2824,#062018);
  --bg-content:#041916;--bg-input:rgba(20,184,166,.12);--bg-secondary:rgba(20,184,166,.08);--bg-hover:rgba(20,184,166,.12);
  --border:rgba(20,184,166,.2);--border-s:rgba(20,184,166,.5);
  --t1:#ecfdf5;--t2:#99f6e4;--t3:#5eead4;--acc:#2dd4bf;--acc2:#5eead4;
  --glow:rgba(45,212,191,.35);--grad:linear-gradient(135deg,#0d9488,#2dd4bf);
  --nab:rgba(20,184,166,.16);--nab2:rgba(20,184,166,.45);--sc:#2dd4bf;
  --cs:0 2px 16px rgba(0,0,0,.5);--ch:0 6px 24px rgba(20,184,166,.25);--chip:rgba(20,184,166,.15);
}
body[data-theme="duralux"]{
  --bg-body:linear-gradient(145deg,#f0f4ff,#e8edff,#f4f6ff);--bg-card:#fff;--bg-header:rgba(255,255,255,.97);
  --bg-sidebar:linear-gradient(180deg,#f0f4ff,#e8edff);--bg-content:#f0f4ff;
  --bg-input:rgba(76,111,255,.06);--bg-secondary:rgba(76,111,255,.05);--bg-hover:rgba(76,111,255,.07);
  --border:rgba(76,111,255,.2);--border-s:rgba(76,111,255,.45);
  --t1:#0f1a3e;--t2:#3d4f8a;--t3:#7a8fc4;--acc:#4c6fff;--acc2:#818cf8;
  --glow:rgba(76,111,255,.28);--grad:linear-gradient(135deg,#4c6fff,#818cf8);
  --nab:rgba(76,111,255,.1);--nab2:rgba(76,111,255,.35);--sc:#4c6fff;
  --cs:0 1px 8px rgba(76,111,255,.1);--ch:0 6px 20px rgba(76,111,255,.18);--chip:rgba(76,111,255,.08);
}
body[data-theme="duralux-dark"]{
  --bg-body:linear-gradient(145deg,#060c1f,#0c1535,#080e25);--bg-card:#0e1630;--bg-header:rgba(6,12,31,.98);
  --bg-sidebar:linear-gradient(180deg,#101a38,#0c1430);--bg-content:#090f28;
  --bg-input:rgba(76,111,255,.12);--bg-secondary:rgba(76,111,255,.08);--bg-hover:rgba(76,111,255,.12);
  --border:rgba(76,111,255,.2);--border-s:rgba(76,111,255,.5);
  --t1:#e2e8f0;--t2:#a5b4c8;--t3:#637899;--acc:#818cf8;--acc2:#a5b4fc;
  --glow:rgba(129,140,248,.35);--grad:linear-gradient(135deg,#4c6fff,#818cf8);
  --nab:rgba(76,111,255,.14);--nab2:rgba(76,111,255,.45);--sc:#818cf8;
  --cs:0 2px 16px rgba(0,0,0,.55);--ch:0 6px 24px rgba(76,111,255,.2);--chip:rgba(76,111,255,.15);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;background:var(--bg-body);color:var(--t1);min-height:100vh;line-height:1.5;transition:background .3s,color .3s}
select,input,textarea,button{font-family:inherit}
.portal-shell{max-width:1800px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column}
.header{background:var(--bg-header);border-bottom:1px solid var(--border);padding:0 1.25rem;height:56px;display:flex;align-items:center;justify-content:space-between;gap:1rem;position:sticky;top:0;z-index:200}
.logo-section{display:flex;align-items:center;gap:.65rem}
.logo{width:36px;height:36px;border-radius:10px;background:var(--grad);display:flex;align-items:center;justify-content:center;box-shadow:0 0 14px var(--glow)}
.header-title{font-size:1.05rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.header-actions{display:flex;align-items:center;gap:.5rem}
.live-badge-pill{display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .65rem;border-radius:20px;background:rgba(13,148,136,.12);border:1px solid rgba(13,148,136,.28);font-size:.73rem;font-weight:700;color:#0d9488}
body[data-theme="dark"] .live-badge-pill,body[data-theme="duralux-dark"] .live-badge-pill{color:#2dd4bf}
.status-dot{width:6px;height:6px;border-radius:50%;background:#0d9488;animation:pulseDot 2s infinite}
@keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 rgba(13,148,136,.4)}50%{box-shadow:0 0 0 5px rgba(13,148,136,0)}}
.color-scheme-selector,.filter-select,.search-box{padding:.45rem .75rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.82rem}
.theme-toggle{width:34px;height:34px;border-radius:50%;background:var(--bg-input);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--t1)}
.main-container{display:flex;flex:1;min-height:0;position:relative}
.sidebar{width:210px;min-width:210px;background:var(--bg-sidebar);border-right:1px solid var(--border);padding:1rem 0;flex-shrink:0;transition:width .26s}
.sidebar.collapsed{width:52px;min-width:52px;overflow:hidden}
.sidebar.collapsed .nav-label,.sidebar.collapsed .nav-section-label{display:none}
.sidebar-toggle-btn{position:absolute;right:-14px;top:20px;z-index:300;width:28px;height:28px;border-radius:50%;background:var(--bg-card);border:1px solid var(--border);box-shadow:var(--cs);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--t1)}
.nav-items{display:flex;flex-direction:column;gap:2px;padding:0 .65rem}
.nav-section-label{font-size:.67rem;text-transform:uppercase;letter-spacing:.1em;color:var(--t3);padding:.75rem .6rem .3rem}
.nav-item{display:flex;align-items:center;gap:.65rem;padding:.55rem .7rem;border-radius:9px;cursor:pointer;color:var(--t2);border:1px solid transparent;font-size:.84rem;font-weight:500;user-select:none}
.nav-item:hover{background:var(--bg-hover);color:var(--t1)}
.nav-item.active{background:var(--nab);border-color:var(--nab2);color:var(--t1);font-weight:600}
.content{flex:1;overflow-y:auto;min-width:0;background:var(--bg-content);padding:1.1rem 1.25rem}
.module-section{display:none;animation:fadeSection .25s ease}
.module-section.active{display:block}
@keyframes fadeSection{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.hero-banner{background:var(--grad);border-radius:16px;padding:1.75rem 2rem;margin-bottom:1.75rem;color:#fff;display:flex;align-items:center;gap:1.25rem}
.hero-banner h2{font-size:1.25rem;font-weight:800;margin-bottom:.2rem}
.hero-banner p{font-size:.82rem;opacity:.85}
.top-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.85rem;margin-bottom:1rem}
.stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.1rem;box-shadow:var(--cs);position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
.stat-label{font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--t3);font-weight:700;margin-bottom:.35rem}
.stat-value{font-size:1.9rem;font-weight:900;line-height:1;color:var(--sc)}
.filters-section{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:.9rem 1rem;margin-bottom:1rem;box-shadow:var(--cs)}
.filters-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.65rem}
.filter-group{display:flex;flex-direction:column;gap:.25rem}
.filter-label{font-size:.68rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em}
.export-btn{padding:.5rem 1rem;border-radius:8px;font-size:.82rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.35rem;border:none;background:var(--grad);color:#fff;box-shadow:0 2px 10px var(--glow)}
.reset-btn{padding:.5rem 1rem;border-radius:8px;font-size:.82rem;font-weight:600;cursor:pointer;background:var(--bg-input);color:var(--t1);border:1px solid var(--border)}
.table-section{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.1rem;margin-bottom:1rem;box-shadow:var(--cs)}
.table-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.65rem;margin-bottom:.85rem}
.table-title{font-size:.9rem;font-weight:800;color:var(--t1);display:flex;align-items:center;gap:.35rem}
.chart-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:1rem;box-shadow:var(--cs);margin-bottom:1rem}
.chart-title{font-size:.8rem;font-weight:700;color:var(--t2);margin-bottom:.65rem}
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem}
.tab-bar{display:flex;gap:8px;margin-bottom:1.5rem;flex-wrap:wrap}
.tab-btn{padding:10px 24px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);display:inline-flex;align-items:center;gap:6px}
.tab-btn.active{background:var(--grad);color:#fff;border-color:transparent}
.form-card{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:1.5rem;margin-bottom:1rem;box-shadow:var(--cs)}
.qia-form-page{max-width:100%}
.qia-form-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;flex-wrap:wrap;gap:.75rem}
.qia-form-head h3{font-size:1.05rem;font-weight:800;color:var(--t1)}
.qia-form-section{background:var(--bg-secondary);border:1px solid var(--border);border-radius:14px;padding:1.25rem 1.35rem;margin-bottom:1.1rem}
.qia-form-section-title{font-size:.74rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--acc);margin-bottom:1rem;padding-bottom:.55rem;border-bottom:1px solid var(--border)}
.qia-row-3{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:1rem 1.15rem;width:100%}
.qia-row-2{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:1rem 1.15rem;width:100%}
.qia-span-full{grid-column:1/-1}
.qia-field{display:flex;flex-direction:column;gap:.35rem;min-width:0}
.qia-field label{font-size:.7rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em}
.qia-field input,.qia-field select,.qia-field textarea{width:100%;padding:.58rem .78rem;border-radius:9px;border:1px solid var(--border);background:var(--bg-card);color:var(--t1);font-size:.86rem;line-height:1.35}
.qia-field textarea{min-height:92px;resize:vertical}
.qia-field input:focus,.qia-field select:focus,.qia-field textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--nab)}
.qia-form-actions{display:flex;gap:.65rem;justify-content:flex-end;padding-top:.5rem;border-top:1px solid var(--border);margin-top:.5rem}
@media(max-width:960px){.qia-row-3{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:640px){.qia-row-3,.qia-row-2{grid-template-columns:1fr!important}}
.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;width:100%}
.form-field{display:flex;flex-direction:column;gap:.35rem;min-width:0}
.form-field.full{grid-column:1/-1}
.form-field label{font-size:.72rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em}
.form-field input,.form-field select,.form-field textarea{width:100%;padding:.55rem .75rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.84rem}
.form-field textarea{min-height:90px;resize:vertical}
.section-divider{grid-column:1/-1;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--t3);padding:8px 12px;background:var(--bg-secondary);border-radius:7px;margin-top:4px}
.status-badge{display:inline-block;padding:.18rem .55rem;border-radius:20px;font-size:.68rem;font-weight:700}
.risk-Critical,.risk-Critical{background:rgba(239,68,68,.12);color:#ef4444}
.risk-High{background:rgba(249,115,22,.12);color:#f97316}
.risk-Medium{background:rgba(245,158,11,.12);color:#f59e0b}
.risk-Low{background:rgba(16,185,129,.12);color:#10b981}
.lm-tile{background:var(--bg-card);border:1px solid var(--border);border-radius:13px;padding:.9rem 1rem;cursor:pointer;box-shadow:var(--cs);position:relative;overflow:hidden}
.lm-tile::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
.lm-tile.selected{border-color:var(--nab2);background:var(--nab)}
.lm-tile h3{font-size:.88rem;font-weight:700;margin-bottom:.35rem}
.lm-stat-value{font-size:1.2rem;font-weight:900;color:var(--sc)}
.qa-atab-btn{padding:8px 18px;border-radius:9px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid var(--border);background:var(--bg-input);color:var(--t1)}
.qa-atab-btn.active{background:var(--grad);color:#fff;border-color:transparent}
.qa-criterion-row{display:grid;grid-template-columns:minmax(0,1fr) 72px 52px 52px;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--bg-card);min-height:48px;transition:opacity .2s,background .15s}
.qa-score-header{display:grid;grid-template-columns:minmax(0,1fr) 72px 52px 52px;gap:10px;padding:6px 12px 8px;font-size:.68rem;font-weight:800;text-transform:uppercase;color:var(--t3);letter-spacing:.04em}
.qia-outcome-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:1rem 1.2rem;background:var(--bg-card);border-radius:12px;border:1px solid var(--border);margin-top:1rem}
.qia-outcome-pill{padding:.45rem 1rem;border-radius:999px;font-size:.82rem;font-weight:800}
.qia-score-summary{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-top:1rem;padding:1rem 1.2rem;background:var(--bg-card);border-radius:12px;border:1px solid var(--border)}
.qa-criterion-row.qa-na-active{opacity:.5;background:var(--bg-secondary)}
.qa-criterion-row.qa-row-err{border-color:#ef4444!important;background:rgba(239,68,68,.05)}
.qa-crit-label{overflow:hidden;min-width:0;font-size:.84rem;font-weight:600;display:flex;align-items:center;gap:4px}
.qa-crit-score,.qa-na-btn,.qa-crit-comment{display:flex;justify-content:center;align-items:center}
.qa-info-btn .qa-tooltip{left:auto;right:0;top:calc(100% + 6px);transform:none;white-space:normal}
.qa-na-toggle{padding:4px 8px;border-radius:6px;font-size:.72rem;font-weight:800;cursor:pointer;border:1px solid;white-space:nowrap}
.qa-na-toggle.na-on{background:rgba(99,102,241,.15);border-color:#6366f1;color:#6366f1}
.qa-na-toggle.na-off{background:var(--bg-secondary);border-color:var(--border);color:var(--t3)}
.qa-crit-comment{width:88px;display:flex;justify-content:center;flex-shrink:0}
.qa-check{width:14px;height:14px;accent-color:var(--acc);cursor:pointer}
.qa-score-select{padding:6px 4px;border-radius:7px;border:2px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.9rem;font-weight:800;width:70px;text-align:center;cursor:pointer}
.qa-score-select:disabled{opacity:.25;cursor:not-allowed}
.qa-score-select.qa-required-err{border-color:#ef4444!important;background:rgba(239,68,68,.07)}
.qa-score-pill{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700}
.qa-info-btn{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;background:var(--bg-secondary);border:1px solid var(--border);color:var(--t3);font-size:9px;font-weight:700;cursor:pointer;margin-left:5px;position:relative;flex-shrink:0}
.qa-info-btn:hover .qa-tooltip{display:block}
.qa-tooltip{display:none;position:absolute;left:20px;top:50%;transform:translateY(-50%);background:#1e1b2e;color:#e2e8f0;font-size:11px;line-height:1.5;padding:8px 12px;border-radius:8px;width:240px;z-index:9999;pointer-events:none;box-shadow:0 4px 20px rgba(0,0,0,.4);font-weight:400}
.qa-error-banner{display:none;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.4);color:#dc2626;padding:12px 16px;border-radius:10px;margin-bottom:1rem;font-size:.84rem;font-weight:600}
.loading-wrap{text-align:center;padding:60px 20px}
.loading-wrap .spinner{width:48px;height:48px;border-radius:50%;border:4px solid var(--border);border-top-color:var(--acc);animation:spin .8s linear infinite;margin:0 auto 16px}
@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:1100px){.form-grid,.charts-grid{grid-template-columns:1fr 1fr}.sidebar{display:none}}
.qia-ag-set-filter{padding:.5rem;min-width:200px;max-width:260px}
.qia-ag-set-search{width:100%;box-sizing:border-box;margin-bottom:.45rem;padding:.35rem .5rem;border:1px solid var(--border);border-radius:8px;font-size:.75rem;background:var(--bg-card);color:var(--t1)}
.qia-ag-set-list{max-height:180px;overflow-y:auto;display:flex;flex-direction:column;gap:.2rem}
.qia-ag-set-option{display:flex;align-items:center;gap:.35rem;font-size:.75rem;cursor:pointer;padding:.15rem 0;color:var(--t1)}
.qia-ag-set-actions{display:flex;gap:.35rem;margin-top:.45rem}
.qia-ag-set-actions button{flex:1;padding:.25rem .4rem;font-size:.68rem;font-weight:700;border:1px solid var(--border);border-radius:6px;background:var(--nab);color:var(--acc);cursor:pointer}
</style>
</head>
<body>
<div class="portal-shell">
  <header class="header">
    <div class="logo-section">
      <div class="logo"><i data-lucide="sparkles" style="width:20px;height:20px;color:#fff;stroke:#fff;"></i></div>
      <span class="header-title">QIA Portal</span>
    </div>
    <div class="header-actions">
      <span class="live-badge-pill" id="modeBadge"><span class="status-dot"></span> Demo Mode</span>
      <select class="color-scheme-selector" id="themeScheme" onchange="qiaSetScheme(this.value)">
        <option value="default">QIA Teal</option>
        <option value="duralux">Duralux</option>
      </select>
      <button class="theme-toggle" type="button" onclick="qiaToggleDark()" title="Toggle dark mode"><i data-lucide="moon" id="themeIcon" style="width:16px;height:16px;"></i></button>
    </div>
  </header>
  <div class="main-container">
    <aside class="sidebar" id="sidebar">
      <button class="sidebar-toggle-btn" type="button" onclick="qiaToggleSidebar()"><i data-lucide="chevron-left" style="width:14px;height:14px;"></i></button>
      <nav class="nav-items">
        <div class="nav-section-label">Modules</div>
        <div class="nav-item active" data-module="topics" onclick="qiaShowModule('topics')"><i data-lucide="message-square-text" style="width:17px;height:17px;"></i><span class="nav-label">Topic Analysis</span></div>
        <div class="nav-item" data-module="qa" onclick="qiaShowModule('qa')"><i data-lucide="shield-check" style="width:17px;height:17px;"></i><span class="nav-label">Quality Assurance</span></div>
      </nav>
    </aside>
    <main class="content">
      <section id="mod-topics" class="module-section active">
        <div id="taLoading" class="loading-wrap"><div class="spinner"></div><div id="taLoadStatus">Starting QIA portal…</div></div>
        <div id="taContent" style="display:none;"></div>
      </section>
      <section id="mod-qa" class="module-section">
        <div id="qaLoading" class="loading-wrap"><div class="spinner"></div><div>Loading Quality Assurance...</div></div>
        <div id="qaContent" style="display:none;"></div>
      </section>
    </main>
  </div>
</div>
<script>
// CONFIG
var QIA_DUMMY_MODE = false;
var SP_URL = 'http://sharedspaces:8116/sites/QIA';
var LIST_TOPIC = 'Topic Analysis';
var LIST_QA = 'QIA_QA_Audit';
var qiaTeams = [], qiaTopics = [], qiaQaAudits = [];
