<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Topics Analysis Form</title>
<style>
:root{--bg:#050817;--line:rgba(255,255,255,.12);--green:#29f39a;--red:#ff4b6e}
*{box-sizing:border-box;margin:0;padding:0;font-family:Segoe UI,Arial,sans-serif}
body{background:radial-gradient(circle at top,#111b55 0%,#050817 42%,#02040d 100%);color:#fff}
.qm-app{display:grid;grid-template-columns:255px 1fr;gap:18px;min-height:100vh;padding:14px}
.qm-side{background:linear-gradient(180deg,#091533,#050b21);border:1px solid var(--line);border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:18px}
.qm-brand{display:flex;gap:14px;align-items:center;margin-bottom:12px}
.qm-logo{width:54px;height:54px;border-radius:13px;background:linear-gradient(135deg,#00d4ff,#8d2cff);display:grid;place-items:center;font-weight:900;font-size:20px;box-shadow:0 0 25px rgba(123,44,255,.55)}
.qm-brand h2{font-size:17px;line-height:1.3}
.qm-title{color:#7f8bb0;font-size:12px;margin:14px 0 8px;text-transform:uppercase;letter-spacing:.08em}
.qm-nav a{display:flex;align-items:center;gap:12px;color:#dfe7ff;text-decoration:none;padding:13px 14px;border-radius:10px;margin-bottom:6px;font-size:15px}
.qm-nav a.active,.qm-nav a:hover{background:linear-gradient(90deg,#732cff,#137cff);box-shadow:0 0 18px rgba(19,124,255,.35)}
.qm-profile{margin-top:auto;background:#0a1636;border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;gap:12px;align-items:center}
.qm-avatar{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#276bff,#7b2cff);display:grid;place-items:center;font-weight:900}
.qm-main{display:flex;flex-direction:column;gap:14px}
.qm-top{background:linear-gradient(145deg,#070d2c,#090d31);border:1px solid var(--line);border-radius:18px;padding:22px 28px;display:flex;justify-content:space-between;align-items:center}
.qm-top h1{font-size:28px;margin-bottom:6px}.qm-top p{color:#c4cbe4}
.qm-date{border:1px solid var(--line);padding:13px 18px;border-radius:12px;background:#071331}
.qm-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.qm-kpi{background:linear-gradient(145deg,#0c1439,#09122f);border:1px solid var(--line);border-radius:18px;padding:24px;min-height:145px}
.qm-kpi:nth-child(1){background:linear-gradient(145deg,#23105f,#10143a)}
.qm-kpi:nth-child(2){background:linear-gradient(145deg,#06295f,#081537)}
.qm-kpi:nth-child(3){background:linear-gradient(145deg,#053d3d,#081537)}
.qm-kpi:nth-child(4){background:linear-gradient(145deg,#4b0738,#10143a)}
.qm-kpi h4{color:#d8ddff;font-size:13px;letter-spacing:.04em;margin-bottom:8px}
.qm-num{font-size:34px;font-weight:900;margin-bottom:8px}.good{color:var(--green);font-size:13px}
.qm-panel{background:linear-gradient(145deg,#08112d,#071029);border:1px solid var(--line);border-radius:18px;overflow:hidden}
.qm-panel-head{padding:20px 26px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.qm-panel-head h2{font-size:26px}.qm-actions{display:flex;gap:10px}
.qm-btn{border:none;border-radius:10px;padding:13px 18px;color:white;background:#101c43;border:1px solid var(--line);cursor:pointer;font-weight:700}
.qm-btn.primary{background:linear-gradient(90deg,#842cff,#00c8ff);box-shadow:0 0 22px rgba(0,200,255,.28)}
.qm-btn.danger{background:linear-gradient(90deg,#ff375f,#ff8b3d)}
.qm-btn.small{padding:8px 12px;font-size:12px}
.qm-tabs{display:flex;gap:10px;padding:18px 26px;background:#07102a;border-bottom:1px solid var(--line);flex-wrap:wrap}
.qm-tab{padding:12px 16px;border-radius:10px;background:#091636;border:1px solid var(--line);color:#dfe7ff;font-weight:700}
.qm-tab.active{background:linear-gradient(90deg,#732cff,#137cff)}
.qm-form{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;padding:24px}
.qm-field label{display:block;color:#c2c9e4;font-size:13px;margin-bottom:8px}
.qm-field input,.qm-field select,.qm-field textarea{width:100%;border:1px solid var(--line);background:#091636;color:#fff;border-radius:10px;padding:13px;outline:none}
.qm-full{grid-column:1/-1} textarea{min-height:95px;resize:vertical}
.qm-section-title{grid-column:1/-1;margin-top:8px;padding:13px 16px;border-radius:12px;background:linear-gradient(90deg,rgba(123,44,255,.28),rgba(0,212,255,.14));border:1px solid var(--line);font-size:17px;font-weight:900}
.qm-savebar{padding:18px 24px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:12px;background:#06102a}
.qm-table-wrap{overflow:auto}.qm-table{width:100%;border-collapse:collapse;min-width:1600px}
.qm-table th{background:linear-gradient(90deg,#6f20e9,#028be6,#00c9e8);padding:15px;text-align:left;font-size:13px}
.qm-table td{padding:14px;border-bottom:1px solid rgba(255,255,255,.07);border-right:1px solid rgba(255,255,255,.05);font-size:14px}
.qm-empty td{text-align:center;color:#aeb8d8;padding:42px;font-size:16px}
.qm-badge{display:inline-block;padding:7px 12px;border-radius:8px;font-size:12px;border:1px solid}
.Critical{color:#ff4b87;border-color:#ff4b87;background:rgba(255,75,135,.1)}
.High{color:#ff6b6b;border-color:#ff6b6b;background:rgba(255,107,107,.1)}
.Medium{color:#ffc857;border-color:#ffc857;background:rgba(255,200,87,.1)}
.Low{color:#35f59b;border-color:#35f59b;background:rgba(53,245,155,.1)}
@media(max-width:1100px){.qm-app{grid-template-columns:1fr}.qm-side{display:none}.qm-kpis,.qm-form{grid-template-columns:1fr}}
</style>
</head>
<body>
</aside>
<main class="qm-main">
<div class="qm-top">
<div><h1>Topics Analysis</h1><p>Voice Of customer</p></div>
</div>
<section class="qm-kpis">
<div class="qm-kpi"><h4>TOTAL ANALYSIS</h4><div class="qm-num" id="kTotal">0</div><div class="good">Ready for input</div></div>
<div class="qm-kpi"><h4>REPEATED CALLS</h4><div class="qm-num" id="kRepeat">0</div><div class="good">Auto calculated</div></div>
<div class="qm-kpi"><h4>REOPENED TTs</h4><div class="qm-num" id="kReopen">0</div><div class="good">Auto calculated</div></div>
<div class="qm-kpi"><h4>SAVING POTENTIAL</h4><div class="qm-num" id="kSaving">AED 0</div><div class="good">Auto calculated</div></div>
</section>
<section class="qm-panel">
<div class="qm-panel-head">
<h2>Topics Analysis Form</h2>
<div class="qm-actions">
<button class="qm-btn" onclick="exportCSV()">⇩ Export Submitted Topics</button>
<button class="qm-btn danger" onclick="clearForm()">Clear Form</button>
<button class="qm-btn primary" onclick="saveAnalysis()">＋ Save Analysis</button>
</div>
</div>
<div class="qm-tabs"><div class="qm-tab active">1. Customer Details</div><div class="qm-tab">2. Driver & Root Cause</div><div class="qm-tab">3. FCR / TT Impact</div><div class="qm-tab">4. Action Plan</div></div>
<form id="analysisForm" class="qm-form">
<div class="qm-section-title">Customer & Interaction Details</div>
<div class="qm-field"><label>Date & Time</label><input type="datetime-local" id="dateTime"></div>
<div class="qm-field"><label>INUM</label><input id="inum"></div>
<div class="qm-field"><label>Calling Number</label><input id="callingNumber"></div>
<div class="qm-field"><label>Status of Number</label><select id="numberStatus"><option>Active</option><option>Suspended</option><option>Deactivated</option><option>Pending Activation</option></select></div>
<div class="qm-field"><label>Impacted Number</label><input id="impactedNumber"></div>
<div class="qm-field"><label>Account Number</label><input id="accountNumber"></div>
<div class="qm-field"><label>Segment</label><select id="segment"><option>Consumer</option><option>Enterprise</option></select></div>
<div class="qm-field"><label>LOB</label><select id="lob"><option>Front Office</option><option>Retention</option><option>Back Office</option><option>Billing</option><option>Enterprise</option></select></div>
<div class="qm-field"><label>Product</label><select id="product"><option>Postpaid</option><option>Prepaid</option><option>Home Wireless</option><option>Fiber</option><option>Roaming</option><option>Billing</option></select></div>
<div class="qm-field"><label>Site</label><input id="site"></div>
<div class="qm-field"><label>Agent Name / ID</label><input id="agent"></div>
<div class="qm-field"><label>Call ID</label><input id="callId"></div>
<div class="qm-field qm-full"><label>Customer Claim</label><textarea id="customerClaim" placeholder="Write customer claim exactly from VOC / call / complaint..."></textarea></div>
<div class="qm-field qm-full"><label>Agent Resolution</label><textarea id="agentResolution" placeholder="What did the agent do? Was it correct? Was ownership clear?"></textarea></div>
<div class="qm-section-title">Driver, Root Cause & Gap Identification</div>
<div class="qm-field"><label>Driver</label><select id="driver"><option>Billing</option><option>Network</option><option>Cancellation</option><option>Refund</option><option>SIM / PUK</option><option>Roaming</option><option>Activation</option><option>Technical Support</option></select></div>
<div class="qm-field"><label>Primary Driver</label><input id="primaryDriver"></div>
<div class="qm-field"><label>Secondary Driver</label><input id="secondaryDriver"></div>
<div class="qm-field"><label>Sub Driver</label><input id="subDriver"></div>
<div class="qm-field"><label>Root Cause</label><select id="rootCause"><option>Process Gap</option><option>Agent Knowledge Gap</option><option>System Gap</option><option>Policy Gap</option><option>Communication Gap</option><option>Customer Education Gap</option></select></div>
<div class="qm-field"><label>Identified Gap “Process”</label><select id="processGap"><option>No</option><option>Yes</option></select></div>
<div class="qm-field"><label>Identified Gap “Agent”</label><select id="agentGap"><option>No</option><option>Yes</option></select></div>
<div class="qm-field"><label>Risk Level</label><select id="risk"><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select></div>
<div class="qm-field qm-full"><label>Deep Root Cause Details</label><textarea id="rootCauseDetails"></textarea></div>
<div class="qm-section-title">Repeat, TT, FCR & Validation</div>
<div class="qm-field"><label>Repeated Call?</label><select id="repeated"><option>No</option><option>Yes</option></select></div>
<div class="qm-field"><label>Repeated Calls Count</label><input type="number" id="repeatedCount" placeholder="0"></div>
<div class="qm-field"><label>Repeated TTs Count</label><input type="number" id="repeatedTt" placeholder="0"></div>
<div class="qm-field"><label>Reopened TTs Count</label><input type="number" id="reopenedTt" placeholder="0"></div>
<div class="qm-field"><label>FCR Impact %</label><input type="number" id="fcrImpact" placeholder="0"></div>
<div class="qm-field"><label>Event Triplet Valid?</label><select id="eventTriplet"><option>Yes</option><option>No</option><option>N/A</option></select></div>
<div class="qm-field"><label>Ticket Triplet Valid?</label><select id="ticketTriplet"><option>Yes</option><option>No</option><option>N/A</option></select></div>
<div class="qm-field"><label>FO Resolution Valid?</label><select id="foResolution"><option>Yes</option><option>No</option><option>N/A</option></select></div>
<div class="qm-field"><label>Validation Process Followed?</label><select id="validationProcess"><option>Yes</option><option>No</option><option>Partially</option></select></div>
<div class="qm-field"><label>Leakage Cost AED</label><input type="number" id="leakageCost" placeholder="0"></div>
<div class="qm-field"><label>Saving Potential AED</label><input type="number" id="savingPotential" placeholder="0"></div>
<div class="qm-field"><label>Status</label><select id="status"><option>Open</option><option>In Progress</option><option>Pending</option><option>Closed</option></select></div>
<div class="qm-section-title">Action Plan & Outcome</div>
<div class="qm-field"><label>Owner</label><input id="owner"></div>
<div class="qm-field"><label>Target Date</label><input type="date" id="targetDate"></div>
<div class="qm-field"><label>Expected Outcome</label><select id="outcome"><option>Reduce Repeat Calls</option><option>Improve FCR</option><option>Reduce Reopened TTs</option><option>Improve Customer Experience</option><option>Reduce Cost Leakage</option></select></div>
<div class="qm-field"><label>Priority</label><select id="priority"><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div>
<div class="qm-field qm-full"><label>Action Plan</label><textarea id="actionPlan"></textarea></div>
<div class="qm-field qm-full"><label>Manager / QA Comments</label><textarea id="comments"></textarea></div>
</form>
<div class="qm-savebar"><button class="qm-btn danger" onclick="clearForm()">Clear Form</button><button class="qm-btn primary" onclick="saveAnalysis()">Save Analysis</button></div>
</section>
<section class="qm-panel">
<div class="qm-panel-head"><h2>Submitted Topics Analysis</h2><div class="qm-actions"><button class="qm-btn" onclick="exportCSV()">⇩ Export Submitted Topics</button><button class="qm-btn danger" onclick="clearAll()">Clear All Records</button></div></div>
<div class="qm-table-wrap"><table class="qm-table"><thead><tr>
<th>Delete</th><th>Date</th><th>Topic / Claim</th><th>LOB</th><th>Product</th><th>Segment</th><th>Driver</th><th>Root Cause</th><th>Repeated Calls</th><th>Repeated TTs</th><th>Reopened TTs</th><th>FCR Impact</th><th>Risk</th><th>Status</th><th>Owner</th><th>Saving Potential</th>
</tr></thead><tbody id="analysisRows"></tbody></table></div>
</section>
</main>
</div>
<script>
var records = JSON.parse(localStorage.getItem("qmTopicsAnalysisRecords") || "[]");
function get(id){return document.getElementById(id).value;}
function money(n){return "AED " + Number(n||0).toLocaleString();}
function safe(v){return String(v||"").replace(/[&<>"']/g,function(m){return({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]);});}
function saveAnalysis(){
var r={dateTime:get("dateTime"),inum:get("inum"),callingNumber:get("callingNumber"),numberStatus:get("numberStatus"),impactedNumber:get("impactedNumber"),accountNumber:get("accountNumber"),segment:get("segment"),lob:get("lob"),product:get("product"),site:get("site"),agent:get("agent"),callId:get("callId"),customerClaim:get("customerClaim"),agentResolution:get("agentResolution"),driver:get("driver"),primaryDriver:get("primaryDriver"),secondaryDriver:get("secondaryDriver"),subDriver:get("subDriver"),rootCause:get("rootCause"),processGap:get("processGap"),agentGap:get("agentGap"),risk:get("risk"),rootCauseDetails:get("rootCauseDetails"),repeated:get("repeated"),repeatedCount:Number(get("repeatedCount")||0),repeatedTt:Number(get("repeatedTt")||0),reopenedTt:Number(get("reopenedTt")||0),fcrImpact:Number(get("fcrImpact")||0),eventTriplet:get("eventTriplet"),ticketTriplet:get("ticketTriplet"),foResolution:get("foResolution"),validationProcess:get("validationProcess"),leakageCost:Number(get("leakageCost")||0),savingPotential:Number(get("savingPotential")||0),status:get("status"),owner:get("owner"),targetDate:get("targetDate"),outcome:get("outcome"),priority:get("priority"),actionPlan:get("actionPlan"),comments:get("comments")};
if(!r.dateTime || !r.customerClaim){alert("Please fill Date & Time and Customer Claim");return;}
records.unshift(r);localStorage.setItem("qmTopicsAnalysisRecords",JSON.stringify(records));render();clearForm();
}
function clearForm(){document.getElementById("analysisForm").reset();}
function deleteRecord(index){if(confirm("Delete this wrong submission?")){records.splice(index,1);localStorage.setItem("qmTopicsAnalysisRecords",JSON.stringify(records));render();}}
function clearAll(){if(confirm("Clear all submitted records?")){records=[];localStorage.removeItem("qmTopicsAnalysisRecords");render();}}
function render(){
var body=document.getElementById("analysisRows");body.innerHTML="";
if(records.length===0){body.innerHTML='<tr class="qm-empty"><td colspan="16">No topics analysis submitted yet. Fill the form above and click Save Analysis.</td></tr>';}
else{records.forEach(function(r,index){body.innerHTML+='<tr><td><button class="qm-btn danger small" onclick="deleteRecord('+index+')">Delete</button></td><td>'+safe((r.dateTime||"").replace("T"," "))+'</td><td>'+safe(r.customerClaim)+'</td><td>'+safe(r.lob)+'</td><td>'+safe(r.product)+'</td><td>'+safe(r.segment)+'</td><td>'+safe(r.driver)+'</td><td>'+safe(r.rootCause)+'</td><td>'+safe(r.repeatedCount)+'</td><td>'+safe(r.repeatedTt)+'</td><td>'+safe(r.reopenedTt)+'</td><td style="color:#ff4b6e">'+safe(r.fcrImpact)+'%</td><td><span class="qm-badge '+safe(r.risk)+'">'+safe(r.risk)+'</span></td><td>'+safe(r.status)+'</td><td>'+safe(r.owner)+'</td><td>'+money(r.savingPotential)+'</td></tr>';});}
document.getElementById("kTotal").textContent=records.length.toLocaleString();
document.getElementById("kRepeat").textContent=records.reduce(function(s,r){return s+Number(r.repeatedCount||0)},0).toLocaleString();
document.getElementById("kReopen").textContent=records.reduce(function(s,r){return s+Number(r.reopenedTt||0)},0).toLocaleString();
var saving=records.reduce(function(s,r){return s+Number(r.savingPotential||0)},0);document.getElementById("kSaving").textContent=saving?money(saving):"AED 0";
}
function exportCSV(){
if(records.length===0){alert("No submitted topics to export.");return;}
var headers=["Date Time","INUM","Calling Number","Status of Number","Impacted Number","Account Number","Segment","LOB","Product","Site","Agent","Call ID","Customer Claim","Agent Resolution","Driver","Primary Driver","Secondary Driver","Sub Driver","Root Cause","Process Gap","Agent Gap","Risk","Root Cause Details","Repeated","Repeated Calls Count","Repeated TTs","Reopened TTs","FCR Impact","Event Triplet","Ticket Triplet","FO Resolution","Validation Process","Leakage Cost","Saving Potential","Status","Owner","Target Date","Expected Outcome","Priority","Action Plan","Comments"];
var keys=["dateTime","inum","callingNumber","numberStatus","impactedNumber","accountNumber","segment","lob","product","site","agent","callId","customerClaim","agentResolution","driver","primaryDriver","secondaryDriver","subDriver","rootCause","processGap","agentGap","risk","rootCauseDetails","repeated","repeatedCount","repeatedTt","reopenedTt","fcrImpact","eventTriplet","ticketTriplet","foResolution","validationProcess","leakageCost","savingPotential","status","owner","targetDate","outcome","priority","actionPlan","comments"];
var rows=records.map(function(r){return keys.map(function(k){return r[k];});});
var csv=[headers].concat(rows).map(function(row){return row.map(function(v){return '"'+String(v==null?"":v).replace(/"/g,'""')+'"';}).join(",");}).join("\\n");
var blob=new Blob([csv],{type:"text/csv"});var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="topics_analysis_records.csv";a.click();
}
render();
</script>
</body>
</html>
