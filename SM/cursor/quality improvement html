  var risk=(document.getElementById('taFilterRisk')||{}).value||'';
  var status=(document.getElementById('taFilterStatus')||{}).value||'';
  var from=(document.getElementById('taFilterFrom')||{}).value||'';
  var to=(document.getElementById('taFilterTo')||{}).value||'';
  return qiaTopics.filter(function(r){
    if(lob&&r[taSp('LOB')]!==lob) return false;
    if(product&&r[taSp('Product')]!==product) return false;
    if(driver&&r[taSp('Driver')]!==driver) return false;
